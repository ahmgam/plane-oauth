diff --git a/apps/api/plane/authentication/provider/oauth/oauth.py b/apps/api/plane/authentication/provider/oauth/oauth.py
new file mode 100644
index 0000000000..e0b60697c6
--- /dev/null
+++ b/apps/api/plane/authentication/provider/oauth/oauth.py
@@ -0,0 +1,225 @@
+# Copyright (c) 2023-present Plane Software, Inc. and contributors
+# SPDX-License-Identifier: AGPL-3.0-only
+# See the LICENSE file for details.
+
+# Python imports
+import os
+from datetime import datetime, timedelta
+from urllib.parse import urlencode
+
+import pytz
+
+# Module imports
+from plane.authentication.adapter.error import (
+    AuthenticationException,
+    AUTHENTICATION_ERROR_CODES,
+)
+from plane.authentication.adapter.oauth import OauthAdapter
+from plane.license.utils.instance_value import get_configuration_value
+
+
+def get_nested_value(data, path):
+    """Resolve a dotted path (e.g. "user.email") from a JSON object."""
+    if not path:
+        return None
+    current = data
+    for key in str(path).split("."):
+        if not isinstance(current, dict) or key not in current:
+            return None
+        current = current[key]
+    return current
+
+
+class GenericOAuthProvider(OauthAdapter):
+    provider = "oauth"
+
+    def __init__(self, request, code=None, state=None, callback=None):
+        (
+            OAUTH_CLIENT_ID,
+            OAUTH_CLIENT_SECRET,
+            OAUTH_AUTH_URL,
+            OAUTH_TOKEN_URL,
+            OAUTH_USERINFO_URL,
+            OAUTH_SCOPE,
+            OAUTH_PROVIDER_NAME,
+            OAUTH_ID_FIELD,
+            OAUTH_EMAIL_FIELD,
+            OAUTH_EMAIL_VERIFIED_FIELD,
+            OAUTH_FIRST_NAME_FIELD,
+            OAUTH_LAST_NAME_FIELD,
+            OAUTH_AVATAR_FIELD,
+            OAUTH_ENABLE_EMAIL_VERIFICATION,
+        ) = get_configuration_value(
+            [
+                {
+                    "key": "OAUTH_CLIENT_ID",
+                    "default": os.environ.get("OAUTH_CLIENT_ID"),
+                },
+                {
+                    "key": "OAUTH_CLIENT_SECRET",
+                    "default": os.environ.get("OAUTH_CLIENT_SECRET"),
+                },
+                {
+                    "key": "OAUTH_AUTH_URL",
+                    "default": os.environ.get("OAUTH_AUTH_URL"),
+                },
+                {
+                    "key": "OAUTH_TOKEN_URL",
+                    "default": os.environ.get("OAUTH_TOKEN_URL"),
+                },
+                {
+                    "key": "OAUTH_USERINFO_URL",
+                    "default": os.environ.get("OAUTH_USERINFO_URL"),
+                },
+                {
+                    "key": "OAUTH_SCOPE",
+                    "default": os.environ.get("OAUTH_SCOPE", "openid email profile"),
+                },
+                {
+                    "key": "OAUTH_PROVIDER_NAME",
+                    "default": os.environ.get("OAUTH_PROVIDER_NAME", "OAuth"),
+                },
+                {
+                    "key": "OAUTH_ID_FIELD",
+                    "default": os.environ.get("OAUTH_ID_FIELD", "sub"),
+                },
+                {
+                    "key": "OAUTH_EMAIL_FIELD",
+                    "default": os.environ.get("OAUTH_EMAIL_FIELD", "email"),
+                },
+                {
+                    "key": "OAUTH_EMAIL_VERIFIED_FIELD",
+                    "default": os.environ.get("OAUTH_EMAIL_VERIFIED_FIELD", ""),
+                },
+                {
+                    "key": "OAUTH_FIRST_NAME_FIELD",
+                    "default": os.environ.get("OAUTH_FIRST_NAME_FIELD", "given_name"),
+                },
+                {
+                    "key": "OAUTH_LAST_NAME_FIELD",
+                    "default": os.environ.get("OAUTH_LAST_NAME_FIELD", "family_name"),
+                },
+                {
+                    "key": "OAUTH_AVATAR_FIELD",
+                    "default": os.environ.get("OAUTH_AVATAR_FIELD", "picture"),
+                },
+                {
+                    "key": "OAUTH_ENABLE_EMAIL_VERIFICATION",
+                    "default": os.environ.get("OAUTH_ENABLE_EMAIL_VERIFICATION", "0"),
+                },
+            ]
+        )
+
+        if not (OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET and OAUTH_AUTH_URL and OAUTH_TOKEN_URL and OAUTH_USERINFO_URL):
+            raise AuthenticationException(
+                error_code=AUTHENTICATION_ERROR_CODES["OAUTH_NOT_CONFIGURED"],
+                error_message="OAUTH_NOT_CONFIGURED",
+            )
+
+        self.provider_name = OAUTH_PROVIDER_NAME or "OAuth"
+        self.id_field = OAUTH_ID_FIELD or "sub"
+        self.email_field = OAUTH_EMAIL_FIELD or "email"
+        self.email_verified_field = OAUTH_EMAIL_VERIFIED_FIELD
+        self.first_name_field = OAUTH_FIRST_NAME_FIELD or "given_name"
+        self.last_name_field = OAUTH_LAST_NAME_FIELD or "family_name"
+        self.avatar_field = OAUTH_AVATAR_FIELD or "picture"
+        self.enable_email_verification = OAUTH_ENABLE_EMAIL_VERIFICATION == "1"
+
+        self.scope = OAUTH_SCOPE or "openid email profile"
+        self.token_url = OAUTH_TOKEN_URL
+        self.userinfo_url = OAUTH_USERINFO_URL
+
+        redirect_uri = f"""{"https" if request.is_secure() else "http"}://{request.get_host()}/auth/oauth/callback/"""
+        url_params = {
+            "client_id": OAUTH_CLIENT_ID,
+            "redirect_uri": redirect_uri,
+            "response_type": "code",
+            "scope": self.scope,
+            "state": state,
+        }
+        # Preserve any pre-existing query string on the authorize endpoint
+        separator = "&" if "?" in OAUTH_AUTH_URL else "?"
+        auth_url = f"{OAUTH_AUTH_URL}{separator}{urlencode(url_params)}"
+        super().__init__(
+            request,
+            self.provider,
+            OAUTH_CLIENT_ID,
+            self.scope,
+            redirect_uri,
+            auth_url,
+            self.token_url,
+            self.userinfo_url,
+            OAUTH_CLIENT_SECRET,
+            code,
+            callback=callback,
+        )
+
+    def set_token_data(self):
+        data = {
+            "client_id": self.client_id,
+            "client_secret": self.client_secret,
+            "code": self.code,
+            "redirect_uri": self.redirect_uri,
+            "grant_type": "authorization_code",
+        }
+        token_response = self.get_user_token(data=data, headers={"Accept": "application/json"})
+        super().set_token_data(
+            {
+                "access_token": token_response.get("access_token"),
+                "refresh_token": token_response.get("refresh_token", None),
+                "access_token_expired_at": (
+                    datetime.now(tz=pytz.utc) + timedelta(seconds=token_response.get("expires_in"))
+                    if token_response.get("expires_in")
+                    else None
+                ),
+                "refresh_token_expired_at": (
+                    datetime.fromtimestamp(token_response.get("refresh_token_expired_at"), tz=pytz.utc)
+                    if token_response.get("refresh_token_expired_at")
+                    else None
+                ),
+                "id_token": token_response.get("id_token", ""),
+            }
+        )
+
+    def set_user_data(self):
+        user_info_response = self.get_user_response()
+
+        email = get_nested_value(user_info_response, self.email_field)
+        if not email:
+            raise AuthenticationException(
+                error_code=AUTHENTICATION_ERROR_CODES["INVALID_EMAIL"],
+                error_message="INVALID_EMAIL",
+            )
+
+        # Optionally enforce verified emails. When enabled, the verified flag from
+        # the userinfo payload must be truthy, otherwise the login is rejected —
+        # mirrors the verified-email enforcement of the provider-specific adapters
+        # (GHSA-7j95-vh8g-f365).
+        if self.enable_email_verification and self.email_verified_field:
+            verified = get_nested_value(user_info_response, self.email_verified_field)
+            if not verified or str(verified).lower() not in ("true", "1", "yes", "y"):
+                raise AuthenticationException(
+                    error_code=AUTHENTICATION_ERROR_CODES["OAUTH_PROVIDER_UNVERIFIED_EMAIL"],
+                    error_message="OAUTH_PROVIDER_UNVERIFIED_EMAIL",
+                )
+
+        provider_id = get_nested_value(user_info_response, self.id_field)
+        if provider_id is None:
+            raise AuthenticationException(
+                error_code=AUTHENTICATION_ERROR_CODES["OAUTH_PROVIDER_ERROR"],
+                error_message="OAUTH_PROVIDER_ERROR",
+            )
+
+        super().set_user_data(
+            {
+                "email": email,
+                "user": {
+                    "provider_id": str(provider_id),
+                    "email": email,
+                    "avatar": get_nested_value(user_info_response, self.avatar_field),
+                    "first_name": get_nested_value(user_info_response, self.first_name_field),
+                    "last_name": get_nested_value(user_info_response, self.last_name_field),
+                    "is_password_autoset": True,
+                },
+            }
+        )

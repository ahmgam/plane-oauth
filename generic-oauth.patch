diff --git a/apps/api/plane/tests/unit/auth/test_generic_oauth.py b/apps/api/plane/tests/unit/auth/test_generic_oauth.py
new file mode 100644
index 0000000000..d52313b2d7
--- /dev/null
+++ b/apps/api/plane/tests/unit/auth/test_generic_oauth.py
@@ -0,0 +1,276 @@
+# Copyright (c) 2023-present Plane Software, Inc. and contributors
+# SPDX-License-Identifier: AGPL-3.0-only
+# See the LICENSE file for details.
+
+"""
+Unit tests for the generic OAuth provider (plane.authentication.provider.oauth.oauth).
+
+The provider lets an instance administrator connect any OAuth2 authorization-code
+provider by configuring the authorize/token/userinfo endpoints, the scope and the
+JSON field mappings for the user attributes.
+"""
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from plane.authentication.adapter.error import (
+    AUTHENTICATION_ERROR_CODES,
+    AuthenticationException,
+)
+from plane.authentication.provider.oauth.oauth import GenericOAuthProvider, get_nested_value
+
+# Default config resolved by get_configuration_value (order matches provider __init__)
+DEFAULT_CONFIG = (
+    "client-id",  # OAUTH_CLIENT_ID
+    "client-secret",  # OAUTH_CLIENT_SECRET
+    "https://idp.example.com/authorize",  # OAUTH_AUTH_URL
+    "https://idp.example.com/token",  # OAUTH_TOKEN_URL
+    "https://idp.example.com/userinfo",  # OAUTH_USERINFO_URL
+    "openid email profile",  # OAUTH_SCOPE
+    "My IDP",  # OAUTH_PROVIDER_NAME
+    "sub",  # OAUTH_ID_FIELD
+    "email",  # OAUTH_EMAIL_FIELD
+    "",  # OAUTH_EMAIL_VERIFIED_FIELD
+    "given_name",  # OAUTH_FIRST_NAME_FIELD
+    "family_name",  # OAUTH_LAST_NAME_FIELD
+    "picture",  # OAUTH_AVATAR_FIELD
+    "0",  # OAUTH_ENABLE_EMAIL_VERIFICATION
+)
+
+
+def make_request():
+    request = MagicMock()
+    request.is_secure.return_value = True
+    request.get_host.return_value = "api.plane.example.com"
+    return request
+
+
+def make_provider(config=DEFAULT_CONFIG, code="auth-code", state="state-value"):
+    with patch("plane.authentication.provider.oauth.oauth.get_configuration_value", return_value=config):
+        return GenericOAuthProvider(request=make_request(), code=code, state=state)
+
+
+@pytest.mark.unit
+class TestGetNestedValue:
+    """Test the dotted-path JSON resolver."""
+
+    def test_returns_value_for_top_level_key(self):
+        assert get_nested_value({"email": "a@b.c"}, "email") == "a@b.c"
+
+    def test_returns_value_for_nested_key(self):
+        assert get_nested_value({"user": {"email": "a@b.c"}}, "user.email") == "a@b.c"
+
+    def test_returns_none_for_missing_path(self):
+        assert get_nested_value({"user": {"name": "x"}}, "user.email") is None
+
+    def test_returns_none_for_non_dict_intermediate(self):
+        assert get_nested_value({"user": "not-a-dict"}, "user.email") is None
+
+    def test_returns_none_for_empty_path(self):
+        assert get_nested_value({"email": "a@b.c"}, "") is None
+
+
+@pytest.mark.unit
+class TestGenericOAuthProviderConfiguration:
+    """Test configuration loading and auth URL generation."""
+
+    def test_raises_oauth_not_configured_when_client_id_missing(self):
+        config = list(DEFAULT_CONFIG)
+        config[0] = None
+        with pytest.raises(AuthenticationException) as exc_info:
+            make_provider(config=tuple(config))
+        assert exc_info.value.error_code == AUTHENTICATION_ERROR_CODES["OAUTH_NOT_CONFIGURED"]
+
+    def test_raises_oauth_not_configured_when_endpoint_missing(self):
+        config = list(DEFAULT_CONFIG)
+        config[3] = None  # OAUTH_TOKEN_URL
+        with pytest.raises(AuthenticationException) as exc_info:
+            make_provider(config=tuple(config))
+        assert exc_info.value.error_code == AUTHENTICATION_ERROR_CODES["OAUTH_NOT_CONFIGURED"]
+
+    def test_builds_auth_url_with_params(self):
+        provider = make_provider(state="abc123")
+        assert provider.get_auth_url() == (
+            "https://idp.example.com/authorize?client_id=client-id"
+            "&redirect_uri=https%3A%2F%2Fapi.plane.example.com%2Fauth%2Foauth%2Fcallback%2F"
+            "&response_type=code&scope=openid+email+profile&state=abc123"
+        )
+
+    def test_appends_to_existing_query_string(self):
+        config = list(DEFAULT_CONFIG)
+        config[2] = "https://idp.example.com/authorize?tenant=acme"
+        provider = make_provider(config=tuple(config), state="abc123")
+        assert "https://idp.example.com/authorize?tenant=acme&client_id=client-id" in provider.get_auth_url()
+
+    def test_uses_configured_scope(self):
+        config = list(DEFAULT_CONFIG)
+        config[5] = "email"
+        provider = make_provider(config=tuple(config))
+        assert "scope=email" in provider.get_auth_url()
+
+    def test_provider_name_falls_back_to_oauth(self):
+        config = list(DEFAULT_CONFIG)
+        config[6] = None
+        provider = make_provider(config=tuple(config))
+        assert provider.provider_name == "OAuth"
+
+
+@pytest.mark.unit
+class TestGenericOAuthProviderToken:
+    """Test token exchange."""
+
+    def test_sets_token_data_from_response(self, mocker):
+        provider = make_provider()
+        token_response = {
+            "access_token": "access-123",
+            "refresh_token": "refresh-123",
+            "expires_in": 3600,
+            "id_token": "id-token",
+        }
+        mocker.patch.object(provider, "get_user_token", return_value=token_response)
+
+        provider.set_token_data()
+
+        assert provider.token_data["access_token"] == "access-123"
+        assert provider.token_data["refresh_token"] == "refresh-123"
+        assert provider.token_data["access_token_expired_at"] is not None
+        assert provider.token_data["id_token"] == "id-token"
+
+    def test_token_exchange_sends_client_credentials(self, mocker):
+        provider = make_provider(code="the-code")
+        token_response = {"access_token": "access-123"}
+        get_user_token = mocker.patch.object(provider, "get_user_token", return_value=token_response)
+
+        provider.set_token_data()
+
+        data = get_user_token.call_args.kwargs["data"]
+        assert data["client_id"] == "client-id"
+        assert data["client_secret"] == "client-secret"
+        assert data["code"] == "the-code"
+        assert data["grant_type"] == "authorization_code"
+        assert data["redirect_uri"] == "https://api.plane.example.com/auth/oauth/callback/"
+
+
+@pytest.mark.unit
+class TestGenericOAuthProviderUserData:
+    """Test userinfo mapping."""
+
+    def test_maps_flat_userinfo(self, mocker):
+        provider = make_provider()
+        mocker.patch.object(
+            provider,
+            "get_user_response",
+            return_value={
+                "sub": "user-1",
+                "email": "john@example.com",
+                "given_name": "John",
+                "family_name": "Doe",
+                "picture": "https://idp.example.com/avatar.png",
+            },
+        )
+
+        provider.set_user_data()
+
+        assert provider.user_data["email"] == "john@example.com"
+        user = provider.user_data["user"]
+        assert user["provider_id"] == "user-1"
+        assert user["email"] == "john@example.com"
+        assert user["first_name"] == "John"
+        assert user["last_name"] == "Doe"
+        assert user["avatar"] == "https://idp.example.com/avatar.png"
+        assert user["is_password_autoset"] is True
+
+    def test_maps_nested_userinfo(self, mocker):
+        config = list(DEFAULT_CONFIG)
+        config[7] = "user.sub"
+        config[8] = "user.email"
+        config[10] = "user.given_name"
+        config[11] = "user.family_name"
+        config[12] = "user.picture"
+        provider = make_provider(config=tuple(config))
+        mocker.patch.object(
+            provider,
+            "get_user_response",
+            return_value={
+                "user": {
+                    "sub": "nested-1",
+                    "email": "nested@example.com",
+                    "given_name": "Jane",
+                    "family_name": "Smith",
+                }
+            },
+        )
+
+        provider.set_user_data()
+
+        assert provider.user_data["email"] == "nested@example.com"
+        assert provider.user_data["user"]["provider_id"] == "nested-1"
+        assert provider.user_data["user"]["first_name"] == "Jane"
+
+    def test_raises_when_email_missing(self, mocker):
+        provider = make_provider()
+        mocker.patch.object(provider, "get_user_response", return_value={"sub": "user-1"})
+
+        with pytest.raises(AuthenticationException) as exc_info:
+            provider.set_user_data()
+        assert exc_info.value.error_code == AUTHENTICATION_ERROR_CODES["INVALID_EMAIL"]
+
+    def test_raises_when_provider_id_missing(self, mocker):
+        provider = make_provider()
+        mocker.patch.object(
+            provider,
+            "get_user_response",
+            return_value={"email": "john@example.com"},
+        )
+
+        with pytest.raises(AuthenticationException) as exc_info:
+            provider.set_user_data()
+        assert exc_info.value.error_code == AUTHENTICATION_ERROR_CODES["OAUTH_PROVIDER_ERROR"]
+
+
+@pytest.mark.unit
+class TestGenericOAuthProviderEmailVerification:
+    """Test optional verified-email enforcement."""
+
+    def make_verification_provider(self, verified_field, enabled):
+        config = list(DEFAULT_CONFIG)
+        config[9] = verified_field  # OAUTH_EMAIL_VERIFIED_FIELD
+        config[13] = enabled  # OAUTH_ENABLE_EMAIL_VERIFICATION
+        return make_provider(config=tuple(config))
+
+    def test_rejects_unverified_email_when_enabled(self, mocker):
+        provider = self.make_verification_provider("email_verified", "1")
+        mocker.patch.object(
+            provider,
+            "get_user_response",
+            return_value={"sub": "u", "email": "john@example.com", "email_verified": False},
+        )
+
+        with pytest.raises(AuthenticationException) as exc_info:
+            provider.set_user_data()
+        assert exc_info.value.error_code == AUTHENTICATION_ERROR_CODES["OAUTH_PROVIDER_UNVERIFIED_EMAIL"]
+
+    def test_accepts_verified_email_when_enabled(self, mocker):
+        provider = self.make_verification_provider("email_verified", "1")
+        mocker.patch.object(
+            provider,
+            "get_user_response",
+            return_value={"sub": "u", "email": "john@example.com", "email_verified": True},
+        )
+
+        provider.set_user_data()
+
+        assert provider.user_data["email"] == "john@example.com"
+
+    def test_accepts_unverified_email_when_enforcement_disabled(self, mocker):
+        provider = self.make_verification_provider("email_verified", "0")
+        mocker.patch.object(
+            provider,
+            "get_user_response",
+            return_value={"sub": "u", "email": "john@example.com", "email_verified": False},
+        )
+
+        provider.set_user_data()
+
+        assert provider.user_data["email"] == "john@example.com"

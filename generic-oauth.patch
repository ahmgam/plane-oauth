@@ -0,0 +1,327 @@
+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import { useState } from "react";
+import { isEmpty } from "lodash-es";
+import Link from "next/link";
+import { Controller, useForm } from "react-hook-form";
+// plane internal packages
+import { API_BASE_URL } from "@plane/constants";
+import { Button, getButtonStyling } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import type { IFormattedInstanceConfiguration, TInstanceOauthAuthenticationConfigurationKeys } from "@plane/types";
+import { ToggleSwitch } from "@plane/ui";
+// components
+import { CodeBlock } from "@/components/common/code-block";
+import { ConfirmDiscardModal } from "@/components/common/confirm-discard-modal";
+import type { TControllerInputFormField } from "@/components/common/controller-input";
+import { ControllerInput } from "@/components/common/controller-input";
+import type { TControllerSwitchFormField } from "@/components/common/controller-switch";
+import { ControllerSwitch } from "@/components/common/controller-switch";
+import type { TCopyField } from "@/components/common/copy-field";
+import { CopyField } from "@/components/common/copy-field";
+// hooks
+import { useInstance } from "@/hooks/store";
+
+type Props = {
+  config: IFormattedInstanceConfiguration;
+};
+
+type OauthConfigFormValues = Record<TInstanceOauthAuthenticationConfigurationKeys, string>;
+
+const OAUTH_FORM_SWITCH_FIELD: TControllerSwitchFormField<OauthConfigFormValues> = {
+  name: "ENABLE_OAUTH_SYNC",
+  label: "OAuth",
+};
+
+export function InstanceOauthConfigForm(props: Props) {
+  const { config } = props;
+  // states
+  const [isDiscardChangesModalOpen, setIsDiscardChangesModalOpen] = useState(false);
+  // store hooks
+  const { updateInstanceConfigurations } = useInstance();
+  // form data
+  const {
+    handleSubmit,
+    control,
+    reset,
+    formState: { errors, isDirty, isSubmitting },
+  } = useForm<OauthConfigFormValues>({
+    defaultValues: {
+      OAUTH_PROVIDER_NAME: config["OAUTH_PROVIDER_NAME"] || "OAuth",
+      OAUTH_AUTH_URL: config["OAUTH_AUTH_URL"],
+      OAUTH_TOKEN_URL: config["OAUTH_TOKEN_URL"],
+      OAUTH_USERINFO_URL: config["OAUTH_USERINFO_URL"],
+      OAUTH_SCOPE: config["OAUTH_SCOPE"] || "openid email profile",
+      OAUTH_CLIENT_ID: config["OAUTH_CLIENT_ID"],
+      OAUTH_CLIENT_SECRET: config["OAUTH_CLIENT_SECRET"],
+      OAUTH_ID_FIELD: config["OAUTH_ID_FIELD"] || "sub",
+      OAUTH_EMAIL_FIELD: config["OAUTH_EMAIL_FIELD"] || "email",
+      OAUTH_EMAIL_VERIFIED_FIELD: config["OAUTH_EMAIL_VERIFIED_FIELD"] || "",
+      OAUTH_FIRST_NAME_FIELD: config["OAUTH_FIRST_NAME_FIELD"] || "given_name",
+      OAUTH_LAST_NAME_FIELD: config["OAUTH_LAST_NAME_FIELD"] || "family_name",
+      OAUTH_AVATAR_FIELD: config["OAUTH_AVATAR_FIELD"] || "picture",
+      OAUTH_ENABLE_EMAIL_VERIFICATION: config["OAUTH_ENABLE_EMAIL_VERIFICATION"] || "0",
+      ENABLE_OAUTH_SYNC: config["ENABLE_OAUTH_SYNC"] || "0",
+    },
+  });
+
+  const originURL = !isEmpty(API_BASE_URL) ? API_BASE_URL : typeof window !== "undefined" ? window.location.origin : "";
+
+  const OAUTH_FORM_FIELDS: TControllerInputFormField[] = [
+    {
+      key: "OAUTH_PROVIDER_NAME",
+      type: "text",
+      label: "Provider name",
+      description: (
+        <>
+          The name shown on the sign-in page, e.g. <CodeBlock>Keycloak</CodeBlock> or <CodeBlock>Okta</CodeBlock>.
+        </>
+      ),
+      placeholder: "OAuth",
+      error: Boolean(errors.OAUTH_PROVIDER_NAME),
+      required: true,
+    },
+    {
+      key: "OAUTH_CLIENT_ID",
+      type: "text",
+      label: "Client ID",
+      description: <>The public client ID issued by your OAuth provider.</>,
+      placeholder: "your-client-id",
+      error: Boolean(errors.OAUTH_CLIENT_ID),
+      required: true,
+    },
+    {
+      key: "OAUTH_CLIENT_SECRET",
+      type: "password",
+      label: "Client secret",
+      description: <>The client secret issued by your OAuth provider.</>,
+      placeholder: "your-client-secret",
+      error: Boolean(errors.OAUTH_CLIENT_SECRET),
+      required: true,
+    },
+    {
+      key: "OAUTH_AUTH_URL",
+      type: "text",
+      label: "Authorization URL",
+      description: <>The OAuth 2.0 authorize endpoint of your provider, e.g. the Keycloak authorization endpoint.</>,
+      placeholder: "https://idp.example.com/realms/your-realm/protocol/openid-connect/auth",
+      error: Boolean(errors.OAUTH_AUTH_URL),
+      required: true,
+    },
+    {
+      key: "OAUTH_TOKEN_URL",
+      type: "text",
+      label: "Token URL",
+      description: <>The OAuth 2.0 token endpoint of your provider.</>,
+      placeholder: "https://idp.example.com/realms/your-realm/protocol/openid-connect/token",
+      error: Boolean(errors.OAUTH_TOKEN_URL),
+      required: true,
+    },
+    {
+      key: "OAUTH_USERINFO_URL",
+      type: "text",
+      label: "Userinfo URL",
+      description: <>The endpoint Plane fetches the user profile from using the access token.</>,
+      placeholder: "https://idp.example.com/realms/your-realm/protocol/openid-connect/userinfo",
+      error: Boolean(errors.OAUTH_USERINFO_URL),
+      required: true,
+    },
+    {
+      key: "OAUTH_SCOPE",
+      type: "text",
+      label: "Scope",
+      description: (
+        <>Space-separated OAuth scopes requested during sign in. Leave default for OpenID Connect providers.</>
+      ),
+      placeholder: "openid email profile",
+      error: Boolean(errors.OAUTH_SCOPE),
+      required: false,
+    },
+    {
+      key: "OAUTH_ID_FIELD",
+      type: "text",
+      label: "ID field",
+      description: <>The userinfo JSON field holding the unique user identifier. Dotted paths are supported.</>,
+      placeholder: "sub",
+      error: Boolean(errors.OAUTH_ID_FIELD),
+      required: true,
+    },
+    {
+      key: "OAUTH_EMAIL_FIELD",
+      type: "text",
+      label: "Email field",
+      description: <>The userinfo JSON field holding the user's email address.</>,
+      placeholder: "email",
+      error: Boolean(errors.OAUTH_EMAIL_FIELD),
+      required: true,
+    },
+    {
+      key: "OAUTH_EMAIL_VERIFIED_FIELD",
+      type: "text",
+      label: "Email verified field",
+      description: (
+        <>
+          The userinfo JSON field holding the email-verified flag. Leave empty if your provider does not expose one.
+        </>
+      ),
+      placeholder: "email_verified",
+      error: Boolean(errors.OAUTH_EMAIL_VERIFIED_FIELD),
+      required: false,
+    },
+    {
+      key: "OAUTH_FIRST_NAME_FIELD",
+      type: "text",
+      label: "First name field",
+      description: <>The userinfo JSON field holding the user's first name.</>,
+      placeholder: "given_name",
+      error: Boolean(errors.OAUTH_FIRST_NAME_FIELD),
+      required: true,
+    },
+    {
+      key: "OAUTH_LAST_NAME_FIELD",
+      type: "text",
+      label: "Last name field",
+      description: <>The userinfo JSON field holding the user's last name.</>,
+      placeholder: "family_name",
+      error: Boolean(errors.OAUTH_LAST_NAME_FIELD),
+      required: true,
+    },
+    {
+      key: "OAUTH_AVATAR_FIELD",
+      type: "text",
+      label: "Avatar field",
+      description: <>The userinfo JSON field holding the user's avatar URL.</>,
+      placeholder: "picture",
+      error: Boolean(errors.OAUTH_AVATAR_FIELD),
+      required: false,
+    },
+  ];
+
+  const OAUTH_SERVICE_FIELD: TCopyField[] = [
+    {
+      key: "Callback_URL",
+      label: "Callback URL",
+      url: `${originURL}/auth/oauth/callback/`,
+      description: (
+        <>
+          We will auto-generate this. Paste this into the <CodeBlock darkerShade>Redirect URI</CodeBlock> field of
+          your OAuth application.
+        </>
+      ),
+    },
+  ];
+
+  const onSubmit = async (formData: OauthConfigFormValues) => {
+    const payload: Partial<OauthConfigFormValues> = { ...formData };
+
+    try {
+      const response = await updateInstanceConfigurations(payload);
+      setToast({
+        type: TOAST_TYPE.SUCCESS,
+        title: "Done!",
+        message: "Your OAuth authentication is configured. You should test it now.",
+      });
+      const fieldKeys: TInstanceOauthAuthenticationConfigurationKeys[] = [
+        "OAUTH_PROVIDER_NAME",
+        "OAUTH_AUTH_URL",
+        "OAUTH_TOKEN_URL",
+        "OAUTH_USERINFO_URL",
+        "OAUTH_SCOPE",
+        "OAUTH_CLIENT_ID",
+        "OAUTH_CLIENT_SECRET",
+        "OAUTH_ID_FIELD",
+        "OAUTH_EMAIL_FIELD",
+        "OAUTH_EMAIL_VERIFIED_FIELD",
+        "OAUTH_FIRST_NAME_FIELD",
+        "OAUTH_LAST_NAME_FIELD",
+        "OAUTH_AVATAR_FIELD",
+        "OAUTH_ENABLE_EMAIL_VERIFICATION",
+        "ENABLE_OAUTH_SYNC",
+      ];
+      const nextValues = Object.fromEntries(
+        fieldKeys.map((key) => [key, response.find((item) => item.key === key)?.value ?? ""])
+      ) as OauthConfigFormValues;
+      reset(nextValues);
+    } catch (err) {
+      console.error(err);
+    }
+  };
+
+  const handleGoBack = (e: React.MouseEvent<HTMLAnchorElement, MouseEvent>) => {
+    if (isDirty) {
+      e.preventDefault();
+      setIsDiscardChangesModalOpen(true);
+    }
+  };
+
+  return (
+    <>
+      <ConfirmDiscardModal
+        isOpen={isDiscardChangesModalOpen}
+        onDiscardHref="/authentication"
+        handleClose={() => setIsDiscardChangesModalOpen(false)}
+      />
+      <div className="flex flex-col gap-8">
+        <div className="grid w-full grid-cols-2 gap-x-12 gap-y-8">
+          <div className="col-span-2 flex flex-col gap-y-4 pt-1 md:col-span-1">
+            <div className="pt-2.5 text-18 font-medium">OAuth-provided details for Plane</div>
+            {OAUTH_FORM_FIELDS.map((field) => (
+              <ControllerInput
+                key={field.key}
+                control={control}
+                type={field.type}
+                name={field.key}
+                label={field.label}
+                description={field.description}
+                placeholder={field.placeholder}
+                error={field.error}
+                required={field.required}
+              />
+            ))}
+            <div className="flex items-center justify-between gap-1">
+              <h4 className="text-sm text-custom-text-300">Require a verified email before sign in</h4>
+              <Controller
+                control={control}
+                name="OAUTH_ENABLE_EMAIL_VERIFICATION"
+                render={({ field: { value, onChange } }) => {
+                  const parsedValue = Number.parseInt(typeof value === "string" ? value : String(value ?? "0"), 10);
+                  const isOn = !Number.isNaN(parsedValue) && parsedValue !== 0;
+                  return <ToggleSwitch value={isOn} onChange={() => onChange(isOn ? "0" : "1")} size="sm" />;
+                }}
+              />
+            </div>
+            <ControllerSwitch control={control} field={OAUTH_FORM_SWITCH_FIELD} />
+            <div className="flex flex-col gap-1 pt-4">
+              <div className="flex items-center gap-4">
+                <Button
+                  variant="primary"
+                  size="lg"
+                  onClick={(e) => void handleSubmit(onSubmit)(e)}
+                  loading={isSubmitting}
+                  disabled={!isDirty}
+                >
+                  {isSubmitting ? "Saving" : "Save changes"}
+                </Button>
+                <Link href="/authentication" className={getButtonStyling("secondary", "lg")} onClick={handleGoBack}>
+                  Go back
+                </Link>
+              </div>
+            </div>
+          </div>
+          <div className="col-span-2 md:col-span-1">
+            <div className="flex flex-col gap-y-4 rounded-lg bg-layer-3 px-6 pt-1.5 pb-4">
+              <div className="pt-2 text-18 font-medium">Plane-provided details for your OAuth provider</div>
+              {OAUTH_SERVICE_FIELD.map((field) => (
+                <CopyField key={field.key} label={field.label} url={field.url} description={field.description} />
+              ))}
+            </div>
+          </div>
+        </div>
+      </div>
+    </>
+  );
+}
